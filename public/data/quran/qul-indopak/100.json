{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","ayahs":[{"number":6147,"numberInSurah":1,"juz":30,"text":"وَالۡعٰدِيٰتِ ضَبۡحًا ۙ‏"},{"number":6148,"numberInSurah":2,"juz":30,"text":"فَالۡمُوۡرِيٰتِ قَدۡحًا ۙ‏"},{"number":6149,"numberInSurah":3,"juz":30,"text":"فَالۡمُغِيۡرٰتِ صُبۡحًا ۙ‏"},{"number":6150,"numberInSurah":4,"juz":30,"text":"فَاَثَرۡنَ بِهٖ نَقۡعًا ۙ‏"},{"number":6151,"numberInSurah":5,"juz":30,"text":"فَوَسَطۡنَ بِهٖ جَمۡعًا ۙ‏"},{"number":6152,"numberInSurah":6,"juz":30,"text":"اِنَّ الۡاِنۡسَانَ لِرَبِّهٖ لَـكَنُوۡدٌ ۚ‏"},{"number":6153,"numberInSurah":7,"juz":30,"text":"وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيۡدٌ ۚ‏"},{"number":6154,"numberInSurah":8,"juz":30,"text":"وَاِنَّهٗ لِحُبِّ الۡخَيۡرِ لَشَدِيۡدٌ ؕ‏"},{"number":6155,"numberInSurah":9,"juz":30,"text":"اَفَلَا يَعۡلَمُ اِذَا بُعۡثِرَ مَا فِى الۡقُبُوۡرِۙ‏"},{"number":6156,"numberInSurah":10,"juz":30,"text":"وَحُصِّلَ مَا فِى الصُّدُوۡرِۙ‏"},{"number":6157,"numberInSurah":11,"juz":30,"text":"اِنَّ رَبَّهُمۡ بِهِمۡ يَوۡمَٮِٕذٍ لَّخَبِيۡرٌ‏"}]}