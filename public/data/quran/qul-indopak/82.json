{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","ayahs":[{"number":5830,"numberInSurah":1,"juz":30,"text":"اِذَا السَّمَآءُ انْفَطَرَتۡۙ‏"},{"number":5831,"numberInSurah":2,"juz":30,"text":"وَاِذَا الۡكَوَاكِبُ انْتَثَرَتۡۙ‏"},{"number":5832,"numberInSurah":3,"juz":30,"text":"وَاِذَا الۡبِحَارُ فُجِّرَتۡۙ‏"},{"number":5833,"numberInSurah":4,"juz":30,"text":"وَاِذَا الۡقُبُوۡرُ بُعۡثِرَتۡۙ‏"},{"number":5834,"numberInSurah":5,"juz":30,"text":"عَلِمَتۡ نَفۡسٌ مَّا قَدَّمَتۡ وَاَخَّرَتۡؕ‏"},{"number":5835,"numberInSurah":6,"juz":30,"text":"يٰۤاَيُّهَا الۡاِنۡسَانُ مَا غَرَّكَ بِرَبِّكَ الۡكَرِيۡمِۙ‏"},{"number":5836,"numberInSurah":7,"juz":30,"text":"الَّذِىۡ خَلَقَكَ فَسَوّٰٮكَ فَعَدَلَـكَۙ‏"},{"number":5837,"numberInSurah":8,"juz":30,"text":"فِىۡۤ اَىِّ صُوۡرَةٍ مَّا شَآءَ رَكَّبَكَؕ‏"},{"number":5838,"numberInSurah":9,"juz":30,"text":"كَلَّا بَلۡ تُكَذِّبُوۡنَ بِالدِّيۡنِۙ‏"},{"number":5839,"numberInSurah":10,"juz":30,"text":"وَاِنَّ عَلَيۡكُمۡ لَحٰـفِظِيۡنَۙ‏"},{"number":5840,"numberInSurah":11,"juz":30,"text":"كِرَامًا كَاتِبِيۡنَۙ‏"},{"number":5841,"numberInSurah":12,"juz":30,"text":"يَعۡلَمُوۡنَ مَا تَفۡعَلُوۡنَ‏"},{"number":5842,"numberInSurah":13,"juz":30,"text":"اِنَّ الۡاَبۡرَارَ لَفِىۡ نَعِيۡمٍۚ‏"},{"number":5843,"numberInSurah":14,"juz":30,"text":"وَاِنَّ الۡفُجَّارَ لَفِىۡ جَحِيۡمٍ ۚۖ‏"},{"number":5844,"numberInSurah":15,"juz":30,"text":"يَّصۡلَوۡنَهَا يَوۡمَ الدِّيۡنِ‏"},{"number":5845,"numberInSurah":16,"juz":30,"text":"وَمَا هُمۡ عَنۡهَا بِغَآٮِٕبِيۡنَؕ‏"},{"number":5846,"numberInSurah":17,"juz":30,"text":"وَمَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِۙ‏"},{"number":5847,"numberInSurah":18,"juz":30,"text":"ثُمَّ مَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِؕ‏"},{"number":5848,"numberInSurah":19,"juz":30,"text":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٌ لِّنَفۡسٍ شَيۡـــًٔا​ ؕ وَالۡاَمۡرُ يَوۡمَٮِٕذٍ لِّلَّهِ‏"}]}