{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Al-Burooj","englishNameTranslation":"The Constellations","ayahs":[{"number":5910,"numberInSurah":1,"juz":30,"text":"وَالسَّمَآءِ ذَاتِ الۡبُرُوۡجِۙ‏"},{"number":5911,"numberInSurah":2,"juz":30,"text":"وَالۡيَوۡمِ الۡمَوۡعُوۡدِۙ‏"},{"number":5912,"numberInSurah":3,"juz":30,"text":"وَشَاهِدٍ وَّمَشۡهُوۡدٍؕ‏"},{"number":5913,"numberInSurah":4,"juz":30,"text":"قُتِلَ اَصۡحٰبُ الۡاُخۡدُوۡدِۙ‏"},{"number":5914,"numberInSurah":5,"juz":30,"text":"النَّارِ ذَاتِ الۡوَقُوۡدِۙ‏"},{"number":5915,"numberInSurah":6,"juz":30,"text":"اِذۡ هُمۡ عَلَيۡهَا قُعُوۡدٌ ۙ‏"},{"number":5916,"numberInSurah":7,"juz":30,"text":"وَّهُمۡ عَلٰى مَا يَفۡعَلُوۡنَ بِالۡمُؤۡمِنِيۡنَ شُهُوۡدٌ ؕ‏"},{"number":5917,"numberInSurah":8,"juz":30,"text":"وَمَا نَقَمُوۡا مِنۡهُمۡ اِلَّاۤ اَنۡ يُّؤۡمِنُوۡا بِاللّٰهِ الۡعَزِيۡزِ الۡحَمِيۡدِۙ‏ ﻿﻿"},{"number":5918,"numberInSurah":9,"juz":30,"text":"الَّذِىۡ لَهٗ مُلۡكُ السَّمٰوٰتِ وَالۡاَرۡضِ​ؕ وَ اللّٰهُ عَلٰى كُلِّ شَىۡءٍ شَهِيۡدٌ ؕ‏"},{"number":5919,"numberInSurah":10,"juz":30,"text":"اِنَّ الَّذِيۡنَ فَتَـنُوا الۡمُؤۡمِنِيۡنَ وَ الۡمُؤۡمِنٰتِ ثُمَّ لَمۡ يَتُوۡبُوۡا فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ الۡحَرِيۡقِؕ‏"},{"number":5920,"numberInSurah":11,"juz":30,"text":"اِنَّ الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ لَهُمۡ جَنّٰتٌ تَجۡرِىۡ مِنۡ تَحۡتِهَا الۡاَنۡهٰرُ ؕ ذٰلِكَ الۡفَوۡزُ الۡكَبِيۡرُؕ‏"},{"number":5921,"numberInSurah":12,"juz":30,"text":"اِنَّ بَطۡشَ رَبِّكَ لَشَدِيۡدٌ ؕ‏"},{"number":5922,"numberInSurah":13,"juz":30,"text":"اِنَّهٗ هُوَ يُبۡدِئُ وَيُعِيۡدُ​ ۚ‏"},{"number":5923,"numberInSurah":14,"juz":30,"text":"وَهُوَ الۡغَفُوۡرُ الۡوَدُوۡدُۙ‏"},{"number":5924,"numberInSurah":15,"juz":30,"text":"ذُو الۡعَرۡشِ الۡمَجِيۡدُ ۙ‏"},{"number":5925,"numberInSurah":16,"juz":30,"text":"فَعَّالٌ لِّمَا يُرِيۡدُ ؕ‏"},{"number":5926,"numberInSurah":17,"juz":30,"text":"هَلۡ اَتٰٮكَ حَدِيۡثُ الۡجُـنُوۡدِۙ‏"},{"number":5927,"numberInSurah":18,"juz":30,"text":"فِرۡعَوۡنَ وَثَمُوۡدَؕ‏"},{"number":5928,"numberInSurah":19,"juz":30,"text":"بَلِ الَّذِيۡنَ كَفَرُوۡا فِىۡ تَكۡذِيۡبٍۙ‏"},{"number":5929,"numberInSurah":20,"juz":30,"text":"وَّاللّٰهُ مِنۡ وَّرَآٮِٕهِمۡ مُّحِيۡطٌۚ‏"},{"number":5930,"numberInSurah":21,"juz":30,"text":"بَلۡ هُوَ قُرۡاٰنٌ مَّجِيۡدٌ ۙ‏"},{"number":5931,"numberInSurah":22,"juz":30,"text":"فِىۡ لَوۡحٍ مَّحۡفُوۡظٍ‏"}]}