{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","ayahs":[{"number":6080,"numberInSurah":1,"juz":30,"text":"وَالضُّحٰىۙ‏"},{"number":6081,"numberInSurah":2,"juz":30,"text":"وَالَّيۡلِ اِذَا سَجٰىۙ‏"},{"number":6082,"numberInSurah":3,"juz":30,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ‏"},{"number":6083,"numberInSurah":4,"juz":30,"text":"وَلَـلۡاٰخِرَةُ خَيۡرٌ لَّكَ مِنَ الۡاُوۡلٰىؕ‏"},{"number":6084,"numberInSurah":5,"juz":30,"text":"وَلَسَوۡفَ يُعۡطِيۡكَ رَبُّكَ فَتَرۡضٰىؕ‏"},{"number":6085,"numberInSurah":6,"juz":30,"text":"اَلَمۡ يَجِدۡكَ يَتِيۡمًا فَاٰوٰى‏"},{"number":6086,"numberInSurah":7,"juz":30,"text":"وَوَجَدَكَ ضَآ لًّا فَهَدٰى‏"},{"number":6087,"numberInSurah":8,"juz":30,"text":"وَوَجَدَكَ عَآٮِٕلًا فَاَغۡنٰىؕ‏"},{"number":6088,"numberInSurah":9,"juz":30,"text":"فَاَمَّا الۡيَتِيۡمَ فَلَا تَقۡهَرۡؕ‏"},{"number":6089,"numberInSurah":10,"juz":30,"text":"وَاَمَّا السَّآٮِٕلَ فَلَا تَنۡهَرۡؕ‏"},{"number":6090,"numberInSurah":11,"juz":30,"text":"وَاَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ‏"}]}