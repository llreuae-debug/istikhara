{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Al-Qalam","englishNameTranslation":"The Pen","ayahs":[{"number":5272,"numberInSurah":1,"juz":29,"text":"نٓ​ وَالۡقَلَمِ وَمَا يَسۡطُرُوۡنَۙ‏"},{"number":5273,"numberInSurah":2,"juz":29,"text":"مَاۤ اَنۡتَ بِـنِعۡمَةِ رَبِّكَ بِمَجۡنُوۡنٍ​ۚ‏"},{"number":5274,"numberInSurah":3,"juz":29,"text":"وَاِنَّ لَڪَ لَاَجۡرًا غَيۡرَ مَمۡنُوۡنٍ​ۚ‏"},{"number":5275,"numberInSurah":4,"juz":29,"text":"وَاِنَّكَ لَعَلٰى خُلُقٍ عَظِيۡمٍ‏"},{"number":5276,"numberInSurah":5,"juz":29,"text":"فَسَتُبۡصِرُ وَيُبۡصِرُوۡنَۙ‏"},{"number":5277,"numberInSurah":6,"juz":29,"text":"بِاَيِّٮكُمُ الۡمَفۡتُوۡنُ‏"},{"number":5278,"numberInSurah":7,"juz":29,"text":"اِنَّ رَبَّكَ هُوَ اَعۡلَمُ بِمَنۡ ضَلَّ عَنۡ سَبِيۡلِهٖ وَهُوَ اَعۡلَمُ بِالۡمُهۡتَدِيۡنَ‏"},{"number":5279,"numberInSurah":8,"juz":29,"text":"فَلَا تُطِعِ الۡمُكَذِّبِيۡنَ‏"},{"number":5280,"numberInSurah":9,"juz":29,"text":"وَدُّوۡا لَوۡ تُدۡهِنُ فَيُدۡهِنُوۡنَ‏"},{"number":5281,"numberInSurah":10,"juz":29,"text":"وَلَا تُطِعۡ كُلَّ حَلَّافٍ مَّهِيۡنٍۙ‏"},{"number":5282,"numberInSurah":11,"juz":29,"text":"هَمَّازٍ مَّشَّآءٍۢ بِنَمِيۡمٍۙ‏"},{"number":5283,"numberInSurah":12,"juz":29,"text":"مَّنَّاعٍ لِّلۡخَيۡرِ مُعۡتَدٍ اَثِيۡمٍۙ‏"},{"number":5284,"numberInSurah":13,"juz":29,"text":"عُتُلٍّ ۢ بَعۡدَ ذٰلِكَ زَنِيۡمٍۙ‏"},{"number":5285,"numberInSurah":14,"juz":29,"text":"اَنۡ كَانَ ذَا مَالٍ وَّبَنِيۡنَؕ‏"},{"number":5286,"numberInSurah":15,"juz":29,"text":"اِذَا تُتۡلٰى عَلَيۡهِ اٰيٰتُنَا قَالَ اَسَاطِيۡرُ الۡاَوَّلِيۡنَ‏"},{"number":5287,"numberInSurah":16,"juz":29,"text":"سَنَسِمُهٗ عَلَى الۡخُـرۡطُوۡمِ‏"},{"number":5288,"numberInSurah":17,"juz":29,"text":"اِنَّا بَلَوۡنٰهُمۡ كَمَا بَلَوۡنَاۤ اَصۡحٰبَ الۡجَـنَّةِ​ ۚ اِذۡ اَقۡسَمُوۡا لَيَصۡرِمُنَّهَا مُصۡبِحِيۡنَۙ‏"},{"number":5289,"numberInSurah":18,"juz":29,"text":"وَلَا يَسۡتَثۡنُوۡنَ‏"},{"number":5290,"numberInSurah":19,"juz":29,"text":"فَطَافَ عَلَيۡهَا طَآٮِٕفٌ مِّنۡ رَّبِّكَ وَهُمۡ نَآٮِٕمُوۡنَ‏"},{"number":5291,"numberInSurah":20,"juz":29,"text":"فَاَصۡبَحَتۡ كَالصَّرِيۡمِۙ‏"},{"number":5292,"numberInSurah":21,"juz":29,"text":"فَتَـنَادَوۡا مُصۡبِحِيۡنَۙ‏"},{"number":5293,"numberInSurah":22,"juz":29,"text":"اَنِ اغۡدُوۡا عَلٰى حَرۡثِكُمۡ اِنۡ كُنۡتُمۡ صٰرِمِيۡنَ‏"},{"number":5294,"numberInSurah":23,"juz":29,"text":"فَانۡطَلَقُوۡا وَهُمۡ يَتَخَافَتُوۡنَۙ‏"},{"number":5295,"numberInSurah":24,"juz":29,"text":"اَنۡ لَّا يَدۡخُلَنَّهَا الۡيَوۡمَ عَلَيۡكُمۡ مِّسۡكِيۡنٌۙ‏"},{"number":5296,"numberInSurah":25,"juz":29,"text":"وَّغَدَوۡا عَلٰى حَرۡدٍ قٰدِرِيۡنَ‏"},{"number":5297,"numberInSurah":26,"juz":29,"text":"فَلَمَّا رَاَوۡهَا قَالُوۡۤا اِنَّا لَـضَآلُّوۡنَۙ‏"},{"number":5298,"numberInSurah":27,"juz":29,"text":"بَلۡ نَحۡنُ مَحۡرُوۡمُوۡنَ‏"},{"number":5299,"numberInSurah":28,"juz":29,"text":"قَالَ اَوۡسَطُهُمۡ اَلَمۡ اَقُلۡ لَّكُمۡ لَوۡلَا تُسَبِّحُوۡنَ‏"},{"number":5300,"numberInSurah":29,"juz":29,"text":"قَالُوۡا سُبۡحٰنَ رَبِّنَاۤ اِنَّا كُنَّا ظٰلِمِيۡنَ‏"},{"number":5301,"numberInSurah":30,"juz":29,"text":"فَاَقۡبَلَ بَعۡضُهُمۡ عَلٰى بَعۡضٍ يَّتَلَاوَمُوۡنَ‏"},{"number":5302,"numberInSurah":31,"juz":29,"text":"قَالُوۡا يٰوَيۡلَنَاۤ اِنَّا كُنَّا طٰغِيۡنَ‏"},{"number":5303,"numberInSurah":32,"juz":29,"text":"عَسٰى رَبُّنَاۤ اَنۡ يُّبۡدِلَـنَا خَيۡرًا مِّنۡهَاۤ اِنَّاۤ اِلٰى رَبِّنَا رٰغِبُوۡنَ‏"},{"number":5304,"numberInSurah":33,"juz":29,"text":"كَذٰلِكَ الۡعَذَابُ​ؕ وَلَعَذَابُ الۡاٰخِرَةِ اَكۡبَرُ ​ۘ لَوۡ كَانُوۡا يَعۡلَمُوۡنَ‏ ﻿﻿"},{"number":5305,"numberInSurah":34,"juz":29,"text":"اِنَّ لِلۡمُتَّقِيۡنَ عِنۡدَ رَبِّهِمۡ جَنّٰتِ النَّعِيۡمِ‏"},{"number":5306,"numberInSurah":35,"juz":29,"text":"اَفَنَجۡعَلُ الۡمُسۡلِمِيۡنَ كَالۡمُجۡرِمِيۡنَؕ‏"},{"number":5307,"numberInSurah":36,"juz":29,"text":"مَا لَـكُمۡ كَيۡفَ تَحۡكُمُوۡنَ​ۚ‏"},{"number":5308,"numberInSurah":37,"juz":29,"text":"اَمۡ لَـكُمۡ كِتٰبٌ فِيۡهِ تَدۡرُسُوۡنَۙ‏"},{"number":5309,"numberInSurah":38,"juz":29,"text":"اِنَّ لَـكُمۡ فِيۡهِ لَمَا تَخَيَّرُوۡنَ​ۚ‏"},{"number":5310,"numberInSurah":39,"juz":29,"text":"اَمۡ لَـكُمۡ اَيۡمَانٌ عَلَيۡنَا بَالِغَةٌ اِلٰى يَوۡمِ الۡقِيٰمَةِ​ ۙ اِنَّ لَـكُمۡ لَمَا تَحۡكُمُوۡنَ​ۚ‏"},{"number":5311,"numberInSurah":40,"juz":29,"text":"سَلۡهُمۡ اَيُّهُمۡ بِذٰلِكَ زَعِيۡمٌ ۛۚ‏"},{"number":5312,"numberInSurah":41,"juz":29,"text":"اَمۡ لَهُمۡ شُرَكَآءُ ۛۚ فَلۡيَاۡتُوۡا بِشُرَكَآٮِٕهِمۡ اِنۡ كَانُوۡا صٰدِقِيۡنَ‏ ﻿﻿"},{"number":5313,"numberInSurah":42,"juz":29,"text":"يَوۡمَ يُكۡشَفُ عَنۡ سَاقٍ وَّيُدۡعَوۡنَ اِلَى السُّجُوۡدِ فَلَا يَسۡتَطِيۡعُوۡنَۙ‏ ﻿﻿"},{"number":5314,"numberInSurah":43,"juz":29,"text":"خَاشِعَةً اَبۡصَارُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٌ ؕ وَقَدۡ كَانُوۡا يُدۡعَوۡنَ اِلَى السُّجُوۡدِ وَهُمۡ سٰلِمُوۡنَ‏"},{"number":5315,"numberInSurah":44,"juz":29,"text":"فَذَرۡنِىۡ وَمَنۡ يُّكَذِّبُ بِهٰذَا الۡحَـدِيۡثِ​ؕ سَنَسۡتَدۡرِجُهُمۡ مِّنۡ حَيۡثُ لَا يَعۡلَمُوۡنَۙ‏"},{"number":5316,"numberInSurah":45,"juz":29,"text":"وَاُمۡلِىۡ لَهُمۡ​ؕ اِنَّ كَيۡدِىۡ مَتِيۡنٌ‏"},{"number":5317,"numberInSurah":46,"juz":29,"text":"اَمۡ تَسۡـَٔـلُهُمۡ اَجۡرًا فَهُمۡ مِّنۡ مَّغۡرَمٍ مُّثۡقَلُوۡنَ​ۚ‏"},{"number":5318,"numberInSurah":47,"juz":29,"text":"اَمۡ عِنۡدَهُمُ الۡغَيۡبُ فَهُمۡ يَكۡتُبُوۡنَ‏"},{"number":5319,"numberInSurah":48,"juz":29,"text":"فَاصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُنۡ كَصَاحِبِ الۡحُوۡتِ​ۘ اِذۡ نَادٰى وَهُوَ مَكۡظُوۡمٌؕ‏"},{"number":5320,"numberInSurah":49,"juz":29,"text":"لَوۡلَاۤ اَنۡ تَدٰرَكَهٗ نِعۡمَةٌ مِّنۡ رَّبِّهٖ لَنُبِذَ بِالۡعَرَآءِ وَهُوَ مَذۡمُوۡمٌ‏"},{"number":5321,"numberInSurah":50,"juz":29,"text":"فَاجۡتَبٰهُ رَبُّهٗ فَجَعَلَهٗ مِنَ الصّٰلِحِيۡنَ‏"},{"number":5322,"numberInSurah":51,"juz":29,"text":"وَاِنۡ يَّكَادُ الَّذِيۡنَ كَفَرُوۡا لَيُزۡلِقُوۡنَكَ بِاَبۡصَارِهِمۡ لَمَّا سَمِعُوا الذِّكۡرَ وَيَقُوۡلُوۡنَ اِنَّهٗ لَمَجۡنُوۡنٌ​ۘ‏"},{"number":5323,"numberInSurah":52,"juz":29,"text":"وَمَا هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَ‏"}]}