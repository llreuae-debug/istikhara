{"number":70,"name":"سُورَةُ المَعَارِجِ","englishName":"Al-Ma'aarij","englishNameTranslation":"The Ascending Stairways","ayahs":[{"number":5376,"numberInSurah":1,"juz":29,"text":"سَاَلَ سَآٮِٕلٌ ۢ بِعَذَابٍ وَّاقِعٍۙ‏"},{"number":5377,"numberInSurah":2,"juz":29,"text":"لِّلۡكٰفِرِيۡنَ لَيۡسَ لَهٗ دَافِعٌ ۙ‏"},{"number":5378,"numberInSurah":3,"juz":29,"text":"مِّنَ اللّٰهِ ذِى الۡمَعَارِجِؕ‏"},{"number":5379,"numberInSurah":4,"juz":29,"text":"تَعۡرُجُ الۡمَلٰٓٮِٕكَةُ وَ الرُّوۡحُ اِلَيۡهِ فِىۡ يَوۡمٍ كَانَ مِقۡدَارُهٗ خَمۡسِيۡنَ اَلۡفَ سَنَةٍ​ۚ‏"},{"number":5380,"numberInSurah":5,"juz":29,"text":"فَاصۡبِرۡ صَبۡرًا جَمِيۡلًا‏"},{"number":5381,"numberInSurah":6,"juz":29,"text":"اِنَّهُمۡ يَرَوۡنَهٗ بَعِيۡدًا ۙ‏"},{"number":5382,"numberInSurah":7,"juz":29,"text":"وَّنَرٰٮهُ قَرِيۡبًا ؕ‏"},{"number":5383,"numberInSurah":8,"juz":29,"text":"يَوۡمَ تَكُوۡنُ السَّمَآءُ كَالۡمُهۡلِۙ‏"},{"number":5384,"numberInSurah":9,"juz":29,"text":"وَتَكُوۡنُ الۡجِبَالُ كَالۡعِهۡنِۙ‏"},{"number":5385,"numberInSurah":10,"juz":29,"text":"وَلَا يَسۡـَٔـلُ حَمِيۡمٌ حَمِيۡمًا ۖۚ‏"},{"number":5386,"numberInSurah":11,"juz":29,"text":"يُّبَصَّرُوۡنَهُمۡ​ؕ يَوَدُّ الۡمُجۡرِمُ لَوۡ يَفۡتَدِىۡ مِنۡ عَذَابِ يَوۡمِٮِٕذٍۢ بِبَنِيۡهِۙ‏"},{"number":5387,"numberInSurah":12,"juz":29,"text":"وَ صَاحِبَتِهٖ وَاَخِيۡهِۙ‏"},{"number":5388,"numberInSurah":13,"juz":29,"text":"وَفَصِيۡلَتِهِ الَّتِىۡ تُــْٔوِيۡهِۙ‏"},{"number":5389,"numberInSurah":14,"juz":29,"text":"وَمَنۡ فِى الۡاَرۡضِ جَمِيۡعًا ۙ ثُمَّ يُنۡجِيۡهِۙ‏"},{"number":5390,"numberInSurah":15,"juz":29,"text":"كَلَّا ؕ اِنَّهَا لَظٰىۙ‏"},{"number":5391,"numberInSurah":16,"juz":29,"text":"نَزَّاعَةً لِّلشَّوٰى​ ۖ​ۚ‏"},{"number":5392,"numberInSurah":17,"juz":29,"text":"تَدۡعُوۡا مَنۡ اَدۡبَرَ وَتَوَلّٰىۙ‏"},{"number":5393,"numberInSurah":18,"juz":29,"text":"وَجَمَعَ فَاَوۡعٰى‏"},{"number":5394,"numberInSurah":19,"juz":29,"text":"اِنَّ الۡاِنۡسَانَ خُلِقَ هَلُوۡعًا ۙ‏"},{"number":5395,"numberInSurah":20,"juz":29,"text":"اِذَا مَسَّهُ الشَّرُّ جَزُوۡعًا ۙ‏"},{"number":5396,"numberInSurah":21,"juz":29,"text":"وَاِذَا مَسَّهُ الۡخَيۡرُ مَنُوۡعًا ۙ‏"},{"number":5397,"numberInSurah":22,"juz":29,"text":"اِلَّا الۡمُصَلِّيۡنَۙ‏"},{"number":5398,"numberInSurah":23,"juz":29,"text":"الَّذِيۡنَ هُمۡ عَلٰى صَلَاتِهِمۡ دَآٮِٕمُوۡنَۙ‏"},{"number":5399,"numberInSurah":24,"juz":29,"text":"وَالَّذِيۡنَ فِىۡۤ اَمۡوَالِهِمۡ حَقٌّ مَّعۡلُوۡمٌۙ‏"},{"number":5400,"numberInSurah":25,"juz":29,"text":"لِّلسَّآٮِٕلِ وَالۡمَحۡرُوۡمِۙ‏"},{"number":5401,"numberInSurah":26,"juz":29,"text":"وَالَّذِيۡنَ يُصَدِّقُوۡنَ بِيَوۡمِ الدِّيۡنِۙ‏"},{"number":5402,"numberInSurah":27,"juz":29,"text":"وَالَّذِيۡنَ هُمۡ مِّنۡ عَذَابِ رَبِّهِمۡ مُّشۡفِقُوۡنَ​ۚ‏"},{"number":5403,"numberInSurah":28,"juz":29,"text":"اِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَاۡمُوۡنٍ‏"},{"number":5404,"numberInSurah":29,"juz":29,"text":"وَالَّذِيۡنَ هُمۡ لِفُرُوۡجِهِمۡ حٰفِظُوۡنَۙ‏"},{"number":5405,"numberInSurah":30,"juz":29,"text":"اِلَّا عَلٰٓى اَزۡوَاجِهِمۡ اَوۡ مَا مَلَـكَتۡ اَيۡمَانُهُمۡ فَاِنَّهُمۡ غَيۡرُ مَلُوۡمِيۡنَ​ۚ‏"},{"number":5406,"numberInSurah":31,"juz":29,"text":"فَمَنِ ابۡتَغٰى وَرَآءَ ذٰلِكَ فَاُولٰٓٮِٕكَ هُمُ الۡعٰدُوۡنَ​ۚ‏"},{"number":5407,"numberInSurah":32,"juz":29,"text":"وَالَّذِيۡنَ هُمۡ لِاَمٰنٰتِهِمۡ وَعَهۡدِهِمۡ رٰعُوۡنَ ۙ‏"},{"number":5408,"numberInSurah":33,"juz":29,"text":"وَالَّذِيۡنَ هُمۡ بِشَهٰدٰتِهِمۡ قَآٮِٕمُوۡنَ ۙ‏"},{"number":5409,"numberInSurah":34,"juz":29,"text":"وَالَّذِيۡنَ هُمۡ عَلٰى صَلَاتِهِمۡ يُحَافِظُوۡنَؕ‏"},{"number":5410,"numberInSurah":35,"juz":29,"text":"اُولٰٓٮِٕكَ فِىۡ جَنّٰتٍ مُّكۡرَمُوۡنَؕ‏"},{"number":5411,"numberInSurah":36,"juz":29,"text":"فَمَالِ الَّذِيۡنَ كَفَرُوۡا قِبَلَكَ مُهۡطِعِيۡنَۙ‏"},{"number":5412,"numberInSurah":37,"juz":29,"text":"عَنِ الۡيَمِيۡنِ وَعَنِ الشِّمَالِ عِزِيۡنَ‏"},{"number":5413,"numberInSurah":38,"juz":29,"text":"اَيَطۡمَعُ كُلُّ امۡرِىءٍ مِّنۡهُمۡ اَنۡ يُّدۡخَلَ جَنَّةَ نَعِيۡمٍۙ‏ ﻿﻿"},{"number":5414,"numberInSurah":39,"juz":29,"text":"كَلَّا ؕ اِنَّا خَلَقۡنٰهُمۡ مِّمَّا يَعۡلَمُوۡنَ‏"},{"number":5415,"numberInSurah":40,"juz":29,"text":"فَلَاۤ اُقۡسِمُ بِرَبِّ الۡمَشٰرِقِ وَالۡمَغٰرِبِ اِنَّا لَقٰدِرُوۡنَۙ‏"},{"number":5416,"numberInSurah":41,"juz":29,"text":"عَلٰٓى اَنۡ نُّبَدِّلَ خَيۡرًا مِّنۡهُمۡۙ وَمَا نَحۡنُ بِمَسۡبُوۡقِيۡنَ‏"},{"number":5417,"numberInSurah":42,"juz":29,"text":"فَذَرۡهُمۡ يَخُوۡضُوۡا وَيَلۡعَبُوۡا حَتّٰى يُلٰقُوۡا يَوۡمَهُمُ الَّذِىۡ يُوۡعَدُوۡنَۙ‏"},{"number":5418,"numberInSurah":43,"juz":29,"text":"يَوۡمَ يَخۡرُجُوۡنَ مِنَ الۡاَجۡدَاثِ سِرَاعًا كَاَنَّهُمۡ اِلٰى نُصُبٍ يُّوۡفِضُوۡنَۙ‏ ﻿﻿"},{"number":5419,"numberInSurah":44,"juz":29,"text":"خَاشِعَةً اَبۡصَارُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٌ ؕ ذٰلِكَ الۡيَوۡمُ الَّذِىۡ كَانُوۡا يُوۡعَدُوۡنَ‏"}]}