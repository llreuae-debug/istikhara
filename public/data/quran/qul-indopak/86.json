{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","ayahs":[{"number":5932,"numberInSurah":1,"juz":30,"text":"وَالسَّمَآءِ وَالطَّارِقِۙ‏"},{"number":5933,"numberInSurah":2,"juz":30,"text":"وَمَاۤ اَدۡرٰٮكَ مَا الطَّارِقُۙ‏"},{"number":5934,"numberInSurah":3,"juz":30,"text":"النَّجۡمُ الثَّاقِبُۙ‏"},{"number":5935,"numberInSurah":4,"juz":30,"text":"اِنۡ كُلُّ نَفۡسٍ لَّمَّا عَلَيۡهَا حَافِظٌؕ‏"},{"number":5936,"numberInSurah":5,"juz":30,"text":"فَلۡيَنۡظُرِ الۡاِنۡسَانُ مِمَّ خُلِقَؕ‏"},{"number":5937,"numberInSurah":6,"juz":30,"text":"خُلِقَ مِنۡ مَّآءٍ دَافِقٍۙ‏"},{"number":5938,"numberInSurah":7,"juz":30,"text":"يَّخۡرُجُ مِنۡۢ بَيۡنِ الصُّلۡبِ وَالتَّرَآٮِٕبِؕ‏"},{"number":5939,"numberInSurah":8,"juz":30,"text":"اِنَّهٗ عَلٰى رَجۡعِهٖ لَقَادِرٌؕ‏"},{"number":5940,"numberInSurah":9,"juz":30,"text":"يَوۡمَ تُبۡلَى السَّرَآٮِٕرُۙ‏"},{"number":5941,"numberInSurah":10,"juz":30,"text":"فَمَا لَهٗ مِنۡ قُوَّةٍ وَّلَا نَاصِرٍؕ‏"},{"number":5942,"numberInSurah":11,"juz":30,"text":"وَالسَّمَآءِ ذَاتِ الرَّجۡعِۙ‏"},{"number":5943,"numberInSurah":12,"juz":30,"text":"وَالۡاَرۡضِ ذَاتِ الصَّدۡعِۙ‏"},{"number":5944,"numberInSurah":13,"juz":30,"text":"اِنَّهٗ لَقَوۡلٌ فَصۡلٌۙ‏"},{"number":5945,"numberInSurah":14,"juz":30,"text":"وَّمَا هُوَ بِالۡهَزۡلِؕ‏"},{"number":5946,"numberInSurah":15,"juz":30,"text":"اِنَّهُمۡ يَكِيۡدُوۡنَ كَيۡدًا ۙ‏"},{"number":5947,"numberInSurah":16,"juz":30,"text":"وَّاَكِيۡدُ كَيۡدًا ۚۖ‏"},{"number":5948,"numberInSurah":17,"juz":30,"text":"فَمَهِّلِ الۡكٰفِرِيۡنَ اَمۡهِلۡهُمۡ رُوَيۡدًا‏"}]}