{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","ayahs":[{"number":6044,"numberInSurah":1,"juz":30,"text":"وَالشَّمۡسِ وَضُحٰٮهَا  ۙ‏"},{"number":6045,"numberInSurah":2,"juz":30,"text":"وَالۡقَمَرِ اِذَا تَلٰٮهَا  ۙ‏"},{"number":6046,"numberInSurah":3,"juz":30,"text":"وَالنَّهَارِ اِذَا جَلّٰٮهَا ۙ‏"},{"number":6047,"numberInSurah":4,"juz":30,"text":"وَالَّيۡلِ اِذَا يَغۡشٰٮهَا ۙ‏"},{"number":6048,"numberInSurah":5,"juz":30,"text":"وَالسَّمَآءِ وَمَا بَنٰٮهَا ۙ‏"},{"number":6049,"numberInSurah":6,"juz":30,"text":"وَالۡاَرۡضِ وَمَا طَحٰٮهَا ۙ‏"},{"number":6050,"numberInSurah":7,"juz":30,"text":"وَنَفۡسٍ وَّمَا سَوّٰٮهَا ۙ‏"},{"number":6051,"numberInSurah":8,"juz":30,"text":"فَاَلۡهَمَهَا فُجُوۡرَهَا وَتَقۡوٰٮهَا ۙ‏"},{"number":6052,"numberInSurah":9,"juz":30,"text":"قَدۡ اَفۡلَحَ مَنۡ زَكّٰٮهَا ۙ‏"},{"number":6053,"numberInSurah":10,"juz":30,"text":"وَقَدۡ خَابَ مَنۡ دَسّٰٮهَا ؕ‏"},{"number":6054,"numberInSurah":11,"juz":30,"text":"كَذَّبَتۡ ثَمُوۡدُ بِطَغۡوٰٮهَآ  ۙ‏"},{"number":6055,"numberInSurah":12,"juz":30,"text":"اِذِ انۡۢبَعَثَ اَشۡقٰٮهَا  ۙ‏"},{"number":6056,"numberInSurah":13,"juz":30,"text":"فَقَالَ لَهُمۡ رَسُوۡلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقۡيٰهَا ؕ‏"},{"number":6057,"numberInSurah":14,"juz":30,"text":"فَكَذَّبُوۡهُ فَعَقَرُوۡهَا   ۙفَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُمۡ بِذَنۡۢبِهِمۡ فَسَوّٰٮهَا  ۙ‏"},{"number":6058,"numberInSurah":15,"juz":30,"text":"وَلَا يَخَافُ عُقۡبٰهَا‏"}]}