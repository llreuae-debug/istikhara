{"number":53,"name":"سُورَةُ النَّجۡمِ","englishName":"An-Najm","englishNameTranslation":"The Star","ayahs":[{"number":4785,"numberInSurah":1,"juz":27,"text":"وَالنَّجۡمِ اِذَا هَوٰىۙ‏"},{"number":4786,"numberInSurah":2,"juz":27,"text":"مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوٰى​ۚ‏"},{"number":4787,"numberInSurah":3,"juz":27,"text":"وَمَا يَنۡطِقُ عَنِ الۡهَوٰىؕ‏"},{"number":4788,"numberInSurah":4,"juz":27,"text":"اِنۡ هُوَ اِلَّا وَحۡىٌ يُّوۡحٰىۙ‏"},{"number":4789,"numberInSurah":5,"juz":27,"text":"عَلَّمَهٗ شَدِيۡدُ الۡقُوٰىۙ‏"},{"number":4790,"numberInSurah":6,"juz":27,"text":"ذُوۡ مِرَّةٍؕ فَاسۡتَوٰىۙ‏"},{"number":4791,"numberInSurah":7,"juz":27,"text":"وَهُوَ بِالۡاُفُقِ الۡاَعۡلٰى ؕ‏"},{"number":4792,"numberInSurah":8,"juz":27,"text":"ثُمَّ دَنَا فَتَدَلّٰىۙ‏"},{"number":4793,"numberInSurah":9,"juz":27,"text":"فَكَانَ قَابَ قَوۡسَيۡنِ اَوۡ اَدۡنٰى​ۚ‏"},{"number":4794,"numberInSurah":10,"juz":27,"text":"فَاَوۡحٰۤى الٰى عَبۡدِهٖ مَاۤ اَوۡحٰىؕ‏"},{"number":4795,"numberInSurah":11,"juz":27,"text":"مَا كَذَبَ الۡفُؤَادُ مَا رَاٰى‏"},{"number":4796,"numberInSurah":12,"juz":27,"text":"اَفَتُمٰرُوۡنَهٗ عَلٰى مَا يَرٰى‏"},{"number":4797,"numberInSurah":13,"juz":27,"text":"وَلَقَدۡ رَاٰهُ نَزۡلَةً اُخۡرٰىۙ‏"},{"number":4798,"numberInSurah":14,"juz":27,"text":"عِنۡدَ سِدۡرَةِ الۡمُنۡتَهٰى‏"},{"number":4799,"numberInSurah":15,"juz":27,"text":"عِنۡدَهَا جَنَّةُ الۡمَاۡوٰىؕ‏"},{"number":4800,"numberInSurah":16,"juz":27,"text":"اِذۡ يَغۡشَى السِّدۡرَةَ مَا يَغۡشٰىۙ‏"},{"number":4801,"numberInSurah":17,"juz":27,"text":"مَا زَاغَ الۡبَصَرُ وَمَا طَغٰى‏"},{"number":4802,"numberInSurah":18,"juz":27,"text":"لَقَدۡ رَاٰى مِنۡ اٰيٰتِ رَبِّهِ الۡكُبۡرٰى‏"},{"number":4803,"numberInSurah":19,"juz":27,"text":"اَفَرَءَيۡتُمُ اللّٰتَ وَالۡعُزّٰىۙ‏"},{"number":4804,"numberInSurah":20,"juz":27,"text":"وَمَنٰوةَ الثَّالِثَةَ الۡاُخۡرٰى‏"},{"number":4805,"numberInSurah":21,"juz":27,"text":"اَلَـكُمُ الذَّكَرُ وَلَهُ الۡاُنۡثٰى‏"},{"number":4806,"numberInSurah":22,"juz":27,"text":"تِلۡكَ اِذًا قِسۡمَةٌ ضِيۡزٰى‏"},{"number":4807,"numberInSurah":23,"juz":27,"text":"اِنۡ هِىَ اِلَّاۤ اَسۡمَآءٌ سَمَّيۡتُمُوۡهَاۤ اَنۡتُمۡ وَاٰبَآؤُكُمۡ مَّاۤ اَنۡزَلَ اللّٰهُ بِهَا مِنۡ سُلۡطٰنٍ​ؕ اِنۡ يَّتَّبِعُوۡنَ اِلَّا الظَّنَّ وَمَا تَهۡوَى الۡاَنۡفُسُ​ۚ وَلَقَدۡ جَآءَهُمۡ مِّنۡ رَّبِّهِمُ الۡهُدٰىؕ‏"},{"number":4808,"numberInSurah":24,"juz":27,"text":"اَمۡ لِلۡاِنۡسَانِ مَا تَمَنّٰى   ۖ‏"},{"number":4809,"numberInSurah":25,"juz":27,"text":"فَلِلّٰهِ الۡاٰخِرَةُ وَالۡاُوۡلٰى‏"},{"number":4810,"numberInSurah":26,"juz":27,"text":"وَكَمۡ مِّنۡ مَّلَكٍ فِى السَّمٰوٰتِ لَا تُغۡنِىۡ شَفَاعَتُهُمۡ شَيۡــًٔــا اِلَّا مِنۡۢ بَعۡدِ اَنۡ يَّاۡذَنَ اللّٰهُ لِمَنۡ يَّشَآءُ وَيَرۡضٰى‏"},{"number":4811,"numberInSurah":27,"juz":27,"text":"اِنَّ الَّذِيۡنَ لَا يُؤۡمِنُوۡنَ بِالۡاٰخِرَةِ لَيُسَمُّوۡنَ الۡمَلٰٓٮِٕكَةَ تَسۡمِيَةَ الۡاُنۡثٰى‏"},{"number":4812,"numberInSurah":28,"juz":27,"text":"وَمَا لَهُمۡ بِهٖ مِنۡ عِلۡمٍ​ؕ اِنۡ يَّتَّبِعُوۡنَ اِلَّا الظَّنَّ​ۚ وَاِنَّ الظَّنَّ لَا يُغۡنِىۡ مِنَ الۡحَـقِّ شَيۡـًٔـاۚ‏"},{"number":4813,"numberInSurah":29,"juz":27,"text":"فَاَعۡرِضۡ عَنۡ مَّنۡ تَوَلّٰى ۙ عَنۡ ذِكۡرِنَا وَلَمۡ يُرِدۡ اِلَّا الۡحَيٰوةَ الدُّنۡيَا ؕ‏"},{"number":4814,"numberInSurah":30,"juz":27,"text":"ذٰ لِكَ مَبۡلَـغُهُمۡ مِّنَ الۡعِلۡمِ​ ؕ اِنَّ رَبَّكَ هُوَ اَعۡلَمُ بِمَنۡ ضَلَّ عَنۡ سَبِيۡلِهٖ ۙ وَهُوَ اَعۡلَمُ بِمَنِ اهۡتَدٰى‏"},{"number":4815,"numberInSurah":31,"juz":27,"text":"وَلِلّٰهِ مَا فِى السَّمٰوٰتِ وَمَا فِى الۡاَرۡضِۙ لِيَجۡزِىَ الَّذِيۡنَ اَسَآءُوۡا بِمَا عَمِلُوۡا وَيَجۡزِىَ الَّذِيۡنَ اَحۡسَنُوۡا بِالۡحُسۡنٰى​ ۚ‏"},{"number":4816,"numberInSurah":32,"juz":27,"text":"اَلَّذِيۡنَ يَجۡتَنِبُوۡنَ كَبٰٓٮِٕرَ الۡاِثۡمِ وَالۡفوَاحِشَ اِلَّا اللَّمَمَ​ؕ اِنَّ رَبَّكَ وَاسِعُ الۡمَغۡفِرَةِ​ؕ هُوَ اَعۡلَمُ بِكُمۡ اِذۡ اَنۡشَاَكُمۡ مِّنَ الۡاَرۡضِ وَاِذۡ اَنۡتُمۡ اَجِنَّةٌ فِىۡ بُطُوۡنِ اُمَّهٰتِكُمۡ​ۚ فَلَا تُزَكُّوۡۤا اَنۡفُسَكُمۡ​ ؕ هُوَ اَعۡلَمُ بِمَنِ اتَّقٰى‏"},{"number":4817,"numberInSurah":33,"juz":27,"text":"اَفَرَءَيۡتَ الَّذِىۡ تَوَلّٰىۙ‏"},{"number":4818,"numberInSurah":34,"juz":27,"text":"وَاَعۡطٰى قَلِيۡلًا وَّاَكۡدٰى‏"},{"number":4819,"numberInSurah":35,"juz":27,"text":"اَعِنۡدَهٗ عِلۡمُ الۡغَيۡبِ فَهُوَ يَرٰى‏"},{"number":4820,"numberInSurah":36,"juz":27,"text":"اَمۡ لَمۡ يُنَبَّاۡ بِمَا فِىۡ صُحُفِ مُوۡسٰىۙ‏"},{"number":4821,"numberInSurah":37,"juz":27,"text":"وَاِبۡرٰهِيۡمَ الَّذِىۡ وَفّٰىٓ  ۙ‏"},{"number":4822,"numberInSurah":38,"juz":27,"text":"اَلَّا تَزِرُ وَازِرَةٌ وِّزۡرَ اُخۡرٰىۙ‏"},{"number":4823,"numberInSurah":39,"juz":27,"text":"وَاَنۡ لَّيۡسَ لِلۡاِنۡسَانِ اِلَّا مَا سَعٰىۙ‏"},{"number":4824,"numberInSurah":40,"juz":27,"text":"وَاَنَّ سَعۡيَهٗ سَوۡفَ يُرٰى‏"},{"number":4825,"numberInSurah":41,"juz":27,"text":"ثُمَّ يُجۡزٰٮهُ الۡجَزَآءَ الۡاَوۡفٰىۙ‏"},{"number":4826,"numberInSurah":42,"juz":27,"text":"وَاَنَّ اِلٰى رَبِّكَ الۡمُنۡتَهٰىۙ‏"},{"number":4827,"numberInSurah":43,"juz":27,"text":"وَاَنَّهٗ هُوَ اَضۡحَكَ وَاَبۡكٰىۙ‏"},{"number":4828,"numberInSurah":44,"juz":27,"text":"وَاَنَّهٗ هُوَ اَمَاتَ وَ اَحۡيَا ۙ‏"},{"number":4829,"numberInSurah":45,"juz":27,"text":"وَاَنَّهٗ خَلَقَ الزَّوۡجَيۡنِ الذَّكَرَ وَالۡاُنۡثٰىۙ‏"},{"number":4830,"numberInSurah":46,"juz":27,"text":"مِنۡ نُّطۡفَةٍ اِذَا تُمۡنٰى‏"},{"number":4831,"numberInSurah":47,"juz":27,"text":"وَاَنَّ عَلَيۡهِ النَّشۡاَةَ الۡاُخۡرٰىۙ‏"},{"number":4832,"numberInSurah":48,"juz":27,"text":"وَاَنَّهٗ هُوَ اَغۡنٰى وَ اَقۡنٰىۙ‏"},{"number":4833,"numberInSurah":49,"juz":27,"text":"وَاَنَّهٗ هُوَ رَبُّ الشِّعۡرٰىۙ‏"},{"number":4834,"numberInSurah":50,"juz":27,"text":"وَاَنَّهٗۤ اَهۡلَكَ عَادَا۟ اۨلۡـٮُٔـوْلٰى ۙ‏"},{"number":4835,"numberInSurah":51,"juz":27,"text":"وَثَمُوۡدَا۟ فَمَاۤ اَبۡقٰىۙ‏"},{"number":4836,"numberInSurah":52,"juz":27,"text":"وَقَوۡمَ نُوۡحٍ مِّنۡ قَبۡلُ​ؕ اِنَّهُمۡ كَانُوۡا هُمۡ اَظۡلَمَ وَاَطۡغٰىؕ‏ ﻿﻿"},{"number":4837,"numberInSurah":53,"juz":27,"text":"وَالۡمُؤۡتَفِكَةَ اَهۡوٰىۙ‏"},{"number":4838,"numberInSurah":54,"juz":27,"text":"فَغَشّٰٮهَا مَا غَشّٰى​ۚ‏"},{"number":4839,"numberInSurah":55,"juz":27,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكَ تَتَمَارٰى‏"},{"number":4840,"numberInSurah":56,"juz":27,"text":"هٰذَا نَذِيۡرٌ مِّنَ النُّذُرِ الۡاُوۡلٰٓى‏"},{"number":4841,"numberInSurah":57,"juz":27,"text":"اَزِفَتِ الۡاٰزِفَةُ​ۚ‏"},{"number":4842,"numberInSurah":58,"juz":27,"text":"لَيۡسَ لَهَا مِنۡ دُوۡنِ اللّٰهِ كَاشِفَةٌ ؕ‏"},{"number":4843,"numberInSurah":59,"juz":27,"text":"اَفَمِنۡ هٰذَا الۡحَدِيۡثِ تَعۡجَبُوۡنَۙ‏"},{"number":4844,"numberInSurah":60,"juz":27,"text":"وَتَضۡحَكُوۡنَ وَلَا تَبۡكُوۡنَۙ‏"},{"number":4845,"numberInSurah":61,"juz":27,"text":"وَاَنۡتُمۡ سٰمِدُوۡنَ‏"},{"number":4846,"numberInSurah":62,"juz":27,"text":"فَاسۡجُدُوۡا لِلّٰهِ وَاعۡبُدُوۡا ۩‏"}]}