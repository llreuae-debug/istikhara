{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","ayahs":[{"number":6099,"numberInSurah":1,"juz":30,"text":"وَالتِّيۡنِ وَالزَّيۡتُوۡنِۙ‏"},{"number":6100,"numberInSurah":2,"juz":30,"text":"وَطُوۡرِ سِيۡنِيۡنَۙ‏"},{"number":6101,"numberInSurah":3,"juz":30,"text":"وَهٰذَا الۡبَلَدِ الۡاَمِيۡنِۙ‏"},{"number":6102,"numberInSurah":4,"juz":30,"text":"لَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ فِىۡۤ اَحۡسَنِ تَقۡوِيۡمٍ‏"},{"number":6103,"numberInSurah":5,"juz":30,"text":"ثُمَّ رَدَدۡنٰهُ اَسۡفَلَ سَافِلِيۡنَۙ‏"},{"number":6104,"numberInSurah":6,"juz":30,"text":"اِلَّا الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُمۡ اَجۡرٌ غَيۡرُ مَمۡنُوۡنٍؕ‏"},{"number":6105,"numberInSurah":7,"juz":30,"text":"فَمَا يُكَذِّبُكَ بَعۡدُ بِالدِّيۡنِ‏"},{"number":6106,"numberInSurah":8,"juz":30,"text":"اَلَيۡسَ اللّٰهُ بِاَحۡكَمِ الۡحٰكِمِيۡنَ‏"}]}