{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa","englishNameTranslation":"The Reality","ayahs":[{"number":5324,"numberInSurah":1,"juz":29,"text":"اَلۡحَـآقَّةُ ۙ‏"},{"number":5325,"numberInSurah":2,"juz":29,"text":"مَا الۡحَـآقَّةُ​ ۚ‏"},{"number":5326,"numberInSurah":3,"juz":29,"text":"وَمَاۤ اَدۡرٰٮكَ مَا الۡحَــآقَّةُ ؕ‏"},{"number":5327,"numberInSurah":4,"juz":29,"text":"كَذَّبَتۡ ثَمُوۡدُ وَعَادٌۢ بِالۡقَارِعَةِ‏"},{"number":5328,"numberInSurah":5,"juz":29,"text":"فَاَمَّا ثَمُوۡدُ فَاُهۡلِكُوۡا بِالطَّاغِيَةِ‏"},{"number":5329,"numberInSurah":6,"juz":29,"text":"وَاَمَّا عَادٌ فَاُهۡلِكُوۡا بِرِيۡحٍ صَرۡصَرٍ عَاتِيَةٍۙ‏"},{"number":5330,"numberInSurah":7,"juz":29,"text":"سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٍ وَّثَمٰنِيَةَ اَيَّامٍۙ حُسُوۡمًا ۙ فَتَرَى الۡقَوۡمَ فِيۡهَا صَرۡعٰىۙ كَاَنَّهُمۡ اَعۡجَازُ نَخۡلٍ خَاوِيَةٍ​ ۚ‏"},{"number":5331,"numberInSurah":8,"juz":29,"text":"فَهَلۡ تَرٰى لَهُمۡ مِّنۡۢ بَاقِيَةٍ‏"},{"number":5332,"numberInSurah":9,"juz":29,"text":"وَجَآءَ فِرۡعَوۡنُ وَمَنۡ قَبۡلَهٗ وَالۡمُؤۡتَفِكٰتُ بِالۡخَـاطِئَةِ​ۚ‏"},{"number":5333,"numberInSurah":10,"juz":29,"text":"فَعَصَوۡا رَسُوۡلَ رَبِّهِمۡ فَاَخَذَهُمۡ اَخۡذَةً رَّابِيَةً‏"},{"number":5334,"numberInSurah":11,"juz":29,"text":"اِنَّا لَمَّا طَغَا الۡمَآءُ حَمَلۡنٰكُمۡ فِى الۡجَارِيَةِ ۙ‏"},{"number":5335,"numberInSurah":12,"juz":29,"text":"لِنَجۡعَلَهَا لَـكُمۡ تَذۡكِرَةً وَّتَعِيَهَاۤ اُذُنٌ وَّاعِيَةٌ‏"},{"number":5336,"numberInSurah":13,"juz":29,"text":"فَاِذَا نُفِخَ فِى الصُّوۡرِ نَفۡخَةٌ وَّاحِدَةٌ ۙ‏"},{"number":5337,"numberInSurah":14,"juz":29,"text":"وَحُمِلَتِ الۡاَرۡضُ وَ الۡجِبَالُ فَدُكَّتَا دَكَّةً وَّاحِدَةً ۙ‏"},{"number":5338,"numberInSurah":15,"juz":29,"text":"فَيَوۡمَٮِٕذٍ وَّقَعَتِ الۡوَاقِعَةُ ۙ‏"},{"number":5339,"numberInSurah":16,"juz":29,"text":"وَانْشَقَّتِ السَّمَآءُ فَهِىَ يَوۡمَٮِٕذٍ وَّاهِيَةٌ ۙ‏"},{"number":5340,"numberInSurah":17,"juz":29,"text":"وَّالۡمَلَكُ عَلٰٓى اَرۡجَآٮِٕهَا ​ؕ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَٮِٕذٍ ثَمٰنِيَةٌ ؕ‏"},{"number":5341,"numberInSurah":18,"juz":29,"text":"يَوۡمَٮِٕذٍ تُعۡرَضُوۡنَ لَا تَخۡفٰى مِنۡكُمۡ خَافِيَةٌ‏"},{"number":5342,"numberInSurah":19,"juz":29,"text":"فَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ بِيَمِيۡنِهٖۙ فَيَقُوۡلُ هَآؤُمُ اقۡرَءُوۡا كِتٰبِيَهۡ​ۚ‏"},{"number":5343,"numberInSurah":20,"juz":29,"text":"اِنِّىۡ ظَنَنۡتُ اَنِّىۡ مُلٰقٍ حِسَابِيَهۡ​ۚ‏"},{"number":5344,"numberInSurah":21,"juz":29,"text":"فَهُوَ فِىۡ عِيۡشَةٍ رَّاضِيَةٍۙ‏"},{"number":5345,"numberInSurah":22,"juz":29,"text":"فِىۡ جَنَّةٍ عَالِيَةٍۙ‏"},{"number":5346,"numberInSurah":23,"juz":29,"text":"قُطُوۡفُهَا دَانِيَةٌ‏"},{"number":5347,"numberInSurah":24,"juz":29,"text":"كُلُوۡا وَاشۡرَبُوۡا هَنِيۡٓـــًٔا ۢ بِمَاۤ اَسۡلَفۡتُمۡ فِى الۡاَيَّامِ الۡخَـالِيَةِ‏ ﻿﻿"},{"number":5348,"numberInSurah":25,"juz":29,"text":"وَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ بِشِمَالِهٖ  ۙ فَيَقُوۡلُ يٰلَيۡتَنِىۡ لَمۡ اُوۡتَ كِتٰبِيَهۡ​ۚ‏"},{"number":5349,"numberInSurah":26,"juz":29,"text":"وَلَمۡ اَدۡرِ مَا حِسَابِيَهۡ​ۚ‏"},{"number":5350,"numberInSurah":27,"juz":29,"text":"يٰلَيۡتَهَا كَانَتِ الۡقَاضِيَةَ​ ۚ‏"},{"number":5351,"numberInSurah":28,"juz":29,"text":"مَاۤ اَغۡنٰى عَنِّىۡ مَالِيَهۡۚ‏"},{"number":5352,"numberInSurah":29,"juz":29,"text":"هَلَكَ عَنِّىۡ سُلۡطٰنِيَهۡ​ۚ‏"},{"number":5353,"numberInSurah":30,"juz":29,"text":"خُذُوۡهُ فَغُلُّوۡهُ ۙ‏"},{"number":5354,"numberInSurah":31,"juz":29,"text":"ثُمَّ الۡجَحِيۡمَ صَلُّوۡهُ ۙ‏"},{"number":5355,"numberInSurah":32,"juz":29,"text":"ثُمَّ فِىۡ سِلۡسِلَةٍ ذَرۡعُهَا سَبۡعُوۡنَ ذِرَاعًا فَاسۡلُكُوۡهُ ؕ‏"},{"number":5356,"numberInSurah":33,"juz":29,"text":"اِنَّهٗ كَانَ لَا يُؤۡمِنُ بِاللّٰهِ الۡعَظِيۡمِۙ‏"},{"number":5357,"numberInSurah":34,"juz":29,"text":"وَلَا يَحُضُّ عَلٰى طَعَامِ الۡمِسۡكِيۡنِؕ‏"},{"number":5358,"numberInSurah":35,"juz":29,"text":"فَلَيۡسَ لَـهُ الۡيَوۡمَ هٰهُنَا حَمِيۡمٌۙ‏"},{"number":5359,"numberInSurah":36,"juz":29,"text":"وَّلَا طَعَامٌ اِلَّا مِنۡ غِسۡلِيۡنٍۙ‏"},{"number":5360,"numberInSurah":37,"juz":29,"text":"لَّا يَاۡكُلُهٗۤ اِلَّا الۡخٰطِئُوْنَ‏"},{"number":5361,"numberInSurah":38,"juz":29,"text":"فَلَاۤ اُقۡسِمُ بِمَا تُبۡصِرُوۡنَۙ‏"},{"number":5362,"numberInSurah":39,"juz":29,"text":"وَمَا لَا تُبۡصِرُوۡنَۙ‏"},{"number":5363,"numberInSurah":40,"juz":29,"text":"اِنَّهٗ لَقَوۡلُ رَسُوۡلٍ كَرِيۡمٍۚ ۙ‏"},{"number":5364,"numberInSurah":41,"juz":29,"text":"وَّمَا هُوَ بِقَوۡلِ شَاعِرٍ​ؕ قَلِيۡلًا مَّا تُؤۡمِنُوۡنَۙ‏"},{"number":5365,"numberInSurah":42,"juz":29,"text":"وَلَا بِقَوۡلِ كَاهِنٍ​ؕ قَلِيۡلًا مَّا تَذَكَّرُوۡنَؕ‏"},{"number":5366,"numberInSurah":43,"juz":29,"text":"تَنۡزِيۡلٌ مِّنۡ رَّبِّ الۡعٰلَمِيۡنَ‏"},{"number":5367,"numberInSurah":44,"juz":29,"text":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ الۡاَقَاوِيۡلِۙ‏"},{"number":5368,"numberInSurah":45,"juz":29,"text":"لَاَخَذۡنَا مِنۡهُ بِالۡيَمِيۡنِۙ‏"},{"number":5369,"numberInSurah":46,"juz":29,"text":"ثُمَّ لَقَطَعۡنَا مِنۡهُ الۡوَتِيۡنَ  ۖ‏"},{"number":5370,"numberInSurah":47,"juz":29,"text":"فَمَا مِنۡكُمۡ مِّنۡ اَحَدٍ عَنۡهُ حَاجِزِيۡنَ‏"},{"number":5371,"numberInSurah":48,"juz":29,"text":"وَاِنَّهٗ لَتَذۡكِرَةٌ لِّلۡمُتَّقِيۡنَ‏"},{"number":5372,"numberInSurah":49,"juz":29,"text":"وَاِنَّا لَنَعۡلَمُ اَنَّ مِنۡكُمۡ مُّكَذِّبِيۡنَ‏"},{"number":5373,"numberInSurah":50,"juz":29,"text":"وَاِنَّهٗ لَحَسۡرَةٌ عَلَى الۡكٰفِرِيۡنَ‏"},{"number":5374,"numberInSurah":51,"juz":29,"text":" وَاِنَّهٗ لَحَـقُّ الۡيَقِيۡنِ‏"},{"number":5375,"numberInSurah":52,"juz":29,"text":"فَسَبِّحۡ بِاسۡمِ رَبِّكَ الۡعَظِيۡمِ‏"}]}