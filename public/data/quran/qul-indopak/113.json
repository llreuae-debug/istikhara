{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","ayahs":[{"number":6226,"numberInSurah":1,"juz":30,"text":"قُلۡ اَعُوۡذُ بِرَبِّ الۡفَلَقِۙ‏"},{"number":6227,"numberInSurah":2,"juz":30,"text":"مِنۡ شَرِّ مَا خَلَقَۙ‏"},{"number":6228,"numberInSurah":3,"juz":30,"text":"وَمِنۡ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ‏"},{"number":6229,"numberInSurah":4,"juz":30,"text":"وَمِنۡ شَرِّ النَّفّٰثٰتِ فِى الۡعُقَدِۙ‏"},{"number":6230,"numberInSurah":5,"juz":30,"text":"وَمِنۡ شَرِّ حَاسِدٍ اِذَا حَسَدَ‏"}]}