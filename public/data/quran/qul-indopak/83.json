{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","ayahs":[{"number":5849,"numberInSurah":1,"juz":30,"text":"وَيۡلٌ لِّلۡمُطَفِّفِيۡنَۙ‏"},{"number":5850,"numberInSurah":2,"juz":30,"text":"الَّذِيۡنَ اِذَا اكۡتَالُوۡا عَلَى النَّاسِ يَسۡتَوۡفُوۡنَۖ‏"},{"number":5851,"numberInSurah":3,"juz":30,"text":"وَاِذَا كَالُوۡهُمۡ اَوْ وَّزَنُوۡهُمۡ يُخۡسِرُوۡنَؕ‏"},{"number":5852,"numberInSurah":4,"juz":30,"text":"اَلَا يَظُنُّ اُولٰٓٮِٕكَ اَنَّهُمۡ مَّبۡعُوۡثُوۡنَۙ‏"},{"number":5853,"numberInSurah":5,"juz":30,"text":"لِيَوۡمٍ عَظِيۡمٍۙ‏"},{"number":5854,"numberInSurah":6,"juz":30,"text":"يَّوۡمَ يَقُوۡمُ النَّاسُ لِرَبِّ الۡعٰلَمِيۡنَؕ‏"},{"number":5855,"numberInSurah":7,"juz":30,"text":"كَلَّاۤ اِنَّ كِتٰبَ الۡفُجَّارِ لَفِىۡ سِجِّيۡنٍؕ‏"},{"number":5856,"numberInSurah":8,"juz":30,"text":"وَمَاۤ اَدۡرٰٮكَ مَا سِجِّيۡنٌؕ‏"},{"number":5857,"numberInSurah":9,"juz":30,"text":"كِتٰبٌ مَّرۡقُوۡمٌؕ‏"},{"number":5858,"numberInSurah":10,"juz":30,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَۙ‏"},{"number":5859,"numberInSurah":11,"juz":30,"text":"الَّذِيۡنَ يُكَذِّبُوۡنَ بِيَوۡمِ الدِّيۡنِؕ‏"},{"number":5860,"numberInSurah":12,"juz":30,"text":"وَمَا يُكَذِّبُ بِهٖۤ اِلَّا كُلُّ مُعۡتَدٍ اَثِيۡمٍۙ‏"},{"number":5861,"numberInSurah":13,"juz":30,"text":"اِذَا تُتۡلٰى عَلَيۡهِ اٰيٰتُنَا قَالَ اَسَاطِيۡرُ الۡاَوَّلِيۡنَؕ‏"},{"number":5862,"numberInSurah":14,"juz":30,"text":"كَلَّا​ بَلۡ رَانَ عَلٰى قُلُوۡبِهِمۡ مَّا كَانُوۡا يَكۡسِبُوۡنَ‏"},{"number":5863,"numberInSurah":15,"juz":30,"text":"كَلَّاۤ اِنَّهُمۡ عَنۡ رَّبِّهِمۡ يَوۡمَٮِٕذٍ لَّمَحۡجُوۡبُوۡنَ​ؕ‏"},{"number":5864,"numberInSurah":16,"juz":30,"text":"ثُمَّ اِنَّهُمۡ لَصَالُوا الۡجَحِيۡمِؕ‏"},{"number":5865,"numberInSurah":17,"juz":30,"text":"ثُمَّ يُقَالُ هٰذَا الَّذِىۡ كُنۡتُمۡ بِهٖ تُكَذِّبُوۡنَؕ‏"},{"number":5866,"numberInSurah":18,"juz":30,"text":"كَلَّاۤ اِنَّ كِتٰبَ الۡاَبۡرَارِ لَفِىۡ عِلِّيِّيۡنَؕ‏"},{"number":5867,"numberInSurah":19,"juz":30,"text":"وَمَاۤ اَدۡرٰٮكَ مَا عِلِّيُّوۡنَؕ‏"},{"number":5868,"numberInSurah":20,"juz":30,"text":"كِتٰبٌ مَّرۡقُوۡمٌۙ‏"},{"number":5869,"numberInSurah":21,"juz":30,"text":"يَّشۡهَدُهُ الۡمُقَرَّبُوۡنَؕ‏"},{"number":5870,"numberInSurah":22,"juz":30,"text":"اِنَّ الۡاَبۡرَارَ لَفِىۡ نَعِيۡمٍۙ‏"},{"number":5871,"numberInSurah":23,"juz":30,"text":"عَلَى الۡاَرَآٮِٕكِ يَنۡظُرُوۡنَۙ‏"},{"number":5872,"numberInSurah":24,"juz":30,"text":"تَعۡرِفُ فِىۡ وُجُوۡهِهِمۡ نَضۡرَةَ النَّعِيۡمِ​ۚ‏"},{"number":5873,"numberInSurah":25,"juz":30,"text":"يُسۡقَوۡنَ مِنۡ رَّحِيۡقٍ مَّخۡتُوۡمٍۙ‏"},{"number":5874,"numberInSurah":26,"juz":30,"text":"خِتٰمُهٗ مِسۡكٌ ​ؕ وَفِىۡ ذٰلِكَ فَلۡيَتَنَافَسِ الۡمُتَنــَافِسُوۡنَؕ‏"},{"number":5875,"numberInSurah":27,"juz":30,"text":"وَ مِزَاجُهٗ مِنۡ تَسۡنِيۡمٍۙ‏"},{"number":5876,"numberInSurah":28,"juz":30,"text":"عَيۡنًا يَّشۡرَبُ بِهَا الۡمُقَرَّبُوۡنَؕ‏"},{"number":5877,"numberInSurah":29,"juz":30,"text":"اِنَّ الَّذِيۡنَ اَجۡرَمُوۡا كَانُوۡا مِنَ الَّذِيۡنَ اٰمَنُوۡا يَضۡحَكُوۡنَ  ۖ‏"},{"number":5878,"numberInSurah":30,"juz":30,"text":"وَاِذَا مَرُّوۡا بِهِمۡ يَتَغَامَزُوۡنَ  ۖ‏"},{"number":5879,"numberInSurah":31,"juz":30,"text":"وَاِذَا انۡقَلَبُوۡۤا اِلٰٓى اَهۡلِهِمُ انْقَلَبُوۡا فَكِهِيۡنَ  ۖ‏"},{"number":5880,"numberInSurah":32,"juz":30,"text":"وَاِذَا رَاَوۡهُمۡ قَالُوۡۤا اِنَّ هٰٓؤُلَاۤءِ لَـضَآلُّوۡنَۙ‏"},{"number":5881,"numberInSurah":33,"juz":30,"text":"وَمَاۤ اُرۡسِلُوۡا عَلَيۡهِمۡ حٰفِظِيۡنَۙ‏"},{"number":5882,"numberInSurah":34,"juz":30,"text":"فَالۡيَوۡمَ الَّذِيۡنَ اٰمَنُوۡا مِنَ الۡكُفَّارِ يَضۡحَكُوۡنَۙ‏"},{"number":5883,"numberInSurah":35,"juz":30,"text":"عَلَى الۡاَرَآٮِٕكِۙ يَنۡظُرُوۡنَؕ‏"},{"number":5884,"numberInSurah":36,"juz":30,"text":"هَلۡ ثُوِّبَ الۡكُفَّارُ مَا كَانُوۡا يَفۡعَلُوۡنَ‏"}]}