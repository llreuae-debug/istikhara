{"number":1,"name":"سُورَةُ ٱلْفَاتِحَةِ","englishName":"Al-Faatiha","englishNameTranslation":"The Opening","ayahs":[{"number":1,"numberInSurah":1,"juz":1,"text":"بِسۡمِ اللهِ الرَّحۡمٰنِ الرَّحِيۡمِ"},{"number":2,"numberInSurah":2,"juz":1,"text":"اَلۡحَمۡدُ لِلّٰهِ رَبِّ الۡعٰلَمِيۡنَۙ‏"},{"number":3,"numberInSurah":3,"juz":1,"text":"الرَّحۡمٰنِ الرَّحِيۡمِۙ‏"},{"number":4,"numberInSurah":4,"juz":1,"text":"مٰلِكِ يَوۡمِ الدِّيۡنِؕ‏"},{"number":5,"numberInSurah":5,"juz":1,"text":"اِيَّاكَ نَعۡبُدُ وَاِيَّاكَ نَسۡتَعِيۡنُؕ‏"},{"number":6,"numberInSurah":6,"juz":1,"text":"اِهۡدِنَا الصِّرَاطَ الۡمُسۡتَقِيۡمَۙ‏"},{"number":7,"numberInSurah":7,"juz":1,"text":"صِرَاطَ الَّذِيۡنَ اَنۡعَمۡتَ عَلَيۡهِمۡ ۙ‏ غَيۡرِ الۡمَغۡضُوۡبِ عَلَيۡهِمۡ وَلَا الضَّآلِّيۡنَ‏"}]}