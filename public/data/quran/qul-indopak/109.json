{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","ayahs":[{"number":6208,"numberInSurah":1,"juz":30,"text":"قُلۡ يٰۤاَيُّهَا الۡكٰفِرُوۡنَۙ‏"},{"number":6209,"numberInSurah":2,"juz":30,"text":"لَاۤ اَعۡبُدُ مَا تَعۡبُدُوۡنَۙ‏"},{"number":6210,"numberInSurah":3,"juz":30,"text":"وَلَاۤ اَنۡـتُمۡ عٰبِدُوۡنَ مَاۤ اَعۡبُدُ​ ۚ‏"},{"number":6211,"numberInSurah":4,"juz":30,"text":"وَلَاۤ اَنَا عَابِدٌ مَّا عَبَدۡتُّمۡۙ‏"},{"number":6212,"numberInSurah":5,"juz":30,"text":"وَ لَاۤ اَنۡـتُمۡ عٰبِدُوۡنَ مَاۤ اَعۡبُدُ ؕ‏"},{"number":6213,"numberInSurah":6,"juz":30,"text":"لَـكُمۡ دِيۡنُكُمۡ وَلِىَ دِيۡنِ‏"}]}