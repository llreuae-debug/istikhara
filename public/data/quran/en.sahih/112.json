{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","ayahs":[{"number":6222,"numberInSurah":1,"juz":30,"text":"Say, \"He is Allah, [who is] One,"},{"number":6223,"numberInSurah":2,"juz":30,"text":"Allah, the Eternal Refuge."},{"number":6224,"numberInSurah":3,"juz":30,"text":"He neither begets nor is born,"},{"number":6225,"numberInSurah":4,"juz":30,"text":"Nor is there to Him any equivalent.\""}]}