{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","ayahs":[{"number":6231,"numberInSurah":1,"juz":30,"text":"Say, \"I seek refuge in the Lord of mankind,"},{"number":6232,"numberInSurah":2,"juz":30,"text":"The Sovereign of mankind."},{"number":6233,"numberInSurah":3,"juz":30,"text":"The God of mankind,"},{"number":6234,"numberInSurah":4,"juz":30,"text":"From the evil of the retreating whisperer -"},{"number":6235,"numberInSurah":5,"juz":30,"text":"Who whispers [evil] into the breasts of mankind -"},{"number":6236,"numberInSurah":6,"juz":30,"text":"From among the jinn and mankind.\""}]}