{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","ayahs":[{"number":6177,"numberInSurah":1,"juz":30,"text":"عصر کی قسم"},{"number":6178,"numberInSurah":2,"juz":30,"text":"کہ انسان نقصان میں ہے"},{"number":6179,"numberInSurah":3,"juz":30,"text":"مگر وہ لوگ جو ایمان لائے اور نیک عمل کرتے رہے اور آپس میں حق (بات) کی تلقین اور صبر کی تاکید کرتے رہے"}]}