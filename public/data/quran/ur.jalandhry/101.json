{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","ayahs":[{"number":6158,"numberInSurah":1,"juz":30,"text":"کھڑ کھڑانے والی"},{"number":6159,"numberInSurah":2,"juz":30,"text":"کھڑ کھڑانے والی کیا ہے؟"},{"number":6160,"numberInSurah":3,"juz":30,"text":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟"},{"number":6161,"numberInSurah":4,"juz":30,"text":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے"},{"number":6162,"numberInSurah":5,"juz":30,"text":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون"},{"number":6163,"numberInSurah":6,"juz":30,"text":"تو جس کے (اعمال کے) وزن بھاری نکلیں گے"},{"number":6164,"numberInSurah":7,"juz":30,"text":"وہ دل پسند عیش میں ہو گا"},{"number":6165,"numberInSurah":8,"juz":30,"text":"اور جس کے وزن ہلکے نکلیں گے"},{"number":6166,"numberInSurah":9,"juz":30,"text":"اس کا مرجع ہاویہ ہے"},{"number":6167,"numberInSurah":10,"juz":30,"text":"اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟"},{"number":6168,"numberInSurah":11,"juz":30,"text":"دہکتی ہوئی آگ ہے"}]}