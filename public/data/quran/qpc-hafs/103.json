{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","ayahs":[{"number":6177,"numberInSurah":1,"juz":30,"text":" وَٱلْعَصْرِ"},{"number":6178,"numberInSurah":2,"juz":30,"text":"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ"},{"number":6179,"numberInSurah":3,"juz":30,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"}]}